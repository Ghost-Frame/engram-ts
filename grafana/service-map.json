{
  "dashboard": {
    "id": null,
    "uid": "zanverse-service-map",
    "title": "Zanverse Service Map",
    "tags": ["otel", "traces", "overview"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "templating": {
      "list": [
        {
          "name": "tempo_ds",
          "type": "datasource",
          "query": "tempo",
          "current": { "text": "Tempo", "value": "Tempo" }
        },
        {
          "name": "prom_ds",
          "type": "datasource",
          "query": "prometheus",
          "current": { "text": "Prometheus", "value": "Prometheus" }
        }
      ]
    },
    "panels": [
      {
        "title": "Service Graph",
        "type": "nodeGraph",
        "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "targets": [
          {
            "expr": "rate(traces_service_graph_request_total[5m])",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ]
      },
      {
        "title": "All Services - Request Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "targets": [
          {
            "expr": "sum by (service_name) (rate(traces_spanmetrics_calls_total[5m]))",
            "legendFormat": "{{service_name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "title": "All Services - p95 Latency",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_spanmetrics_duration_seconds_bucket[5m])))",
            "legendFormat": "{{service_name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "title": "All Services - Error Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "targets": [
          {
            "expr": "sum by (service_name) (rate(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[5m]))",
            "legendFormat": "{{service_name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": { "drawStyle": "line", "fillOpacity": 10 },
            "color": { "mode": "palette-classic" }
          }
        }
      },
      {
        "title": "Trace Search",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "datasource": { "type": "tempo", "uid": "${tempo_ds}" },
        "targets": [
          {
            "queryType": "traceqlSearch",
            "query": "{ status = error }",
            "limit": 20,
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
