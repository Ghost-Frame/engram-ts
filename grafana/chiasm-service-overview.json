{
  "dashboard": {
    "id": null,
    "uid": "chiasm-service-overview",
    "title": "Chiasm Task Tracker Overview",
    "tags": ["chiasm", "otel", "traces"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "templating": {
      "list": [
        {
          "name": "tempo_ds",
          "type": "datasource",
          "query": "tempo",
          "current": { "text": "Tempo", "value": "Tempo" }
        },
        {
          "name": "prom_ds",
          "type": "datasource",
          "query": "prometheus",
          "current": { "text": "Prometheus", "value": "Prometheus" }
        }
      ]
    },
    "panels": [
      {
        "title": "Request Rate (req/s)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "targets": [
          {
            "expr": "rate(traces_spanmetrics_calls_total{service_name=\"chiasm\"}[5m])",
            "legendFormat": "{{span_name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "title": "Request Latency p95",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_duration_seconds_bucket{service_name=\"chiasm\"}[5m])) by (le, span_name))",
            "legendFormat": "{{span_name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "targets": [
          {
            "expr": "rate(traces_spanmetrics_calls_total{service_name=\"chiasm\", status_code=\"STATUS_CODE_ERROR\"}[5m])",
            "legendFormat": "{{span_name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": { "drawStyle": "line", "fillOpacity": 10 },
            "color": { "mode": "fixed", "fixedColor": "red" }
          }
        }
      },
      {
        "title": "Task Operations",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
        "collapsed": false
      },
      {
        "title": "Task Create Latency",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_duration_seconds_bucket{service_name=\"chiasm\", span_name=\"chiasm.createTask\"}[5m])) by (le))",
            "legendFormat": "createTask p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_duration_seconds_bucket{service_name=\"chiasm\", span_name=\"chiasm.updateTask\"}[5m])) by (le))",
            "legendFormat": "updateTask p95",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "title": "Task Operations Rate",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 9 },
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "targets": [
          {
            "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"chiasm\", span_name=~\"chiasm\\\\.(createTask|updateTask)\"}[5m]))",
            "legendFormat": "ops/s",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "reqps" }
        }
      },
      {
        "title": "Task Operations by Agent",
        "type": "table",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 9 },
        "datasource": { "type": "tempo", "uid": "${tempo_ds}" },
        "targets": [
          {
            "queryType": "traceqlSearch",
            "query": "{ resource.service.name = \"chiasm\" && name =~ \"chiasm\\\\..*Task\" }",
            "limit": 20,
            "refId": "A"
          }
        ]
      },
      {
        "title": "Trace Explorer",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
        "collapsed": false
      },
      {
        "title": "Recent Traces",
        "type": "table",
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
        "datasource": { "type": "tempo", "uid": "${tempo_ds}" },
        "targets": [
          {
            "queryType": "traceqlSearch",
            "query": "{ resource.service.name = \"chiasm\" }",
            "limit": 50,
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
